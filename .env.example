# Copy to .env.local for development. In production set these in your host's
# environment settings, never in a file.

# ── Database ─────────────────────────────────────────────────────────────
# Postgres. Neon, Supabase, Vercel Postgres and Railway all work.
# Use the POOLED connection string on serverless — the direct one runs out of
# connections under load.
DATABASE_URL=

# ── Session ──────────────────────────────────────────────────────────────
# Signs the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is the correct panic button.
SESSION_SECRET=

# ── Identity ─────────────────────────────────────────────────────────────
# The origin learners actually visit. Must match the address in the browser
# bar exactly, or every sign-in is rejected: the wallet signs this domain and
# the server checks it. On Vercel, VERCEL_PROJECT_PRODUCTION_URL and
# VERCEL_URL are read automatically, so previews work without extra config.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Every custom domain the site answers on, comma-separated. Sign-in is
# domain-bound, and the VERCEL_* variables only describe Vercel's own
# hostnames — a domain you attached has to be named here or every signature
# made on it is refused. The www. counterpart is accepted automatically.
# SITE_HOSTS=solana-school.com

# Wallets that can read reference solutions and approve side quest claims.
# Comma separated, case-sensitive base58.
# NEVER prefix with NEXT_PUBLIC_ — that publishes the list to every visitor.
ADMIN_PUBKEYS=

# ── GitHub ───────────────────────────────────────────────────────────────
# Use a DEDICATED BOT ACCOUNT that owns no repositories and belongs to no
# organizations. Artifact downloads need the full `repo` scope on a classic
# token — `public_repo` is not enough — and that scope means read AND write on
# everything the account can reach. On a bot account with nothing behind it,
# a leak is boring. On your own account it is not.
#
# Fine-grained tokens cannot do this job: they only grant repositories you
# own, and learner forks are owned by learners.
GITHUB_TOKEN=

# ── Devnet ───────────────────────────────────────────────────────────────
# Read-only RPC for challenges graded on-chain (Assignment 08, Metaplex
# Core): one getAccountInfo per submission. Defaults to the public devnet
# endpoint, which rate-limits; set a Helius/Triton devnet URL before a whole
# cohort submits in the same ten minutes.
# DEVNET_RPC_URL=https://api.devnet.solana.com
